# =============================================================================
# GeoTask Pro — Environment Variables
# =============================================================================
# Copy to .env and fill all values marked as REQUIRED.
# NEVER commit .env to version control.
# Generate secrets: openssl rand -base64 32
# =============================================================================

# --- Database (REQUIRED) -----------------------------------------------------
# AWS RDS PostgreSQL — get endpoint from RDS Console after instance creation
# Format: postgresql://USER:PASSWORD@RDS_ENDPOINT:5432/DATABASE?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/geotask?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/geotask?sslmode=require"

# --- Security (REQUIRED) -----------------------------------------------------
# JWT signing secret — minimum 32 chars — generate: openssl rand -base64 32
JWT_SECRET=""

# Cron job authentication secret — generate: openssl rand -hex 32
CRON_SECRET=""

# Default password assigned to newly created users (they must change on first login)
DEFAULT_USER_PASSWORD="Mudar@123"

# Admin maintenance endpoint secret — generate: openssl rand -hex 32
ADMIN_MAINTENANCE_SECRET=""

# --- AWS S3 (REQUIRED for file uploads) --------------------------------------
# S3 bucket name — create in AWS Console before first deploy
AWS_S3_BUCKET="geotask-attachments"
AWS_REGION="us-east-1"

# IAM user credentials with s3:PutObject, s3:DeleteObject, s3:GetObject on the bucket
# On EC2 with instance profile/IAM role attached, these can be left empty
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Optional: CloudFront CDN domain for serving uploaded files
# AWS_CLOUDFRONT_DOMAIN="d1234abcd.cloudfront.net"

# --- Application (REQUIRED) --------------------------------------------------
NEXTAUTH_URL="https://app.yourdomain.com.br"

# --- AI Features (optional) --------------------------------------------------
# XAI_API_KEY=""

# =============================================================================
# LOCAL DEVELOPMENT ONLY (used by docker-compose.dev.yml)
# =============================================================================
# POSTGRES_PASSWORD="devpassword"
# MINIO_ROOT_USER="admin"
# MINIO_ROOT_PASSWORD="minioadmin123"

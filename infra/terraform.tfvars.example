# Copy to terraform.tfvars and fill values — NEVER commit terraform.tfvars
# (it contains the db_password)

aws_region        = "us-east-1"
app_name          = "geotask"
root_domain       = "geogis.com.br"
subdomain         = "geotask"
ec2_instance_type = "t3.small"
ec2_key_pair_name = "geotask-keypair"   # Name of key pair created in AWS Console

db_username          = "geotask"
db_password          = "CHANGE_ME_STRONG_PASSWORD"
db_instance_class    = "db.t3.micro"
db_allocated_storage = 20

s3_bucket_name = "geotask-attachments-prod"
